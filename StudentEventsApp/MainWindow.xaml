<Window x:Class="StudentRegistryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстр студентів"
        Height="730"
        Width="1200"
        MinHeight="620"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="Margin" Value="0,5,8,5"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,5,0,13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">

            <TextBlock Text="Реєстр студентів"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="Лабораторна робота №5 • Колекції, делегати та LINQ"
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Дані студента"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="ID"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Ім'я"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding StudentName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Вік"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding StudentAge, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Маса (кг)"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding StudentMass, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Оцінки"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding StudentMarks, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Наприклад: 85, 90, 76, 100"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   Margin="0,-8,0,15"/>

                        <WrapPanel>

                            <Button Content="Додати"
                                    Command="{Binding AddCommand}"
                                    Style="{StaticResource ActionButton}"/>

                            <Button Content="Оновити"
                                    Command="{Binding UpdateCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Background="#0891B2"/>

                            <Button Content="Видалити"
                                    Command="{Binding RemoveCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Background="#DC2626"/>

                            <Button Content="Очистити"
                                    Command="{Binding ClearCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Background="#64748B"/>

                        </WrapPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Список студентів"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,0,0,18"/>

                    <Grid Grid.Row="1" Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Пошук за ім'ям"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox Style="{StaticResource InputBox}"
                                     Margin="0,5,0,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Мін. середній бал"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Margin="0,5,0,0"
                                     Text="{Binding MinimumMark, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="4">

                            <TextBlock Text="Сортувати за"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox Height="34"
                                      Margin="0,5,0,0"
                                      Padding="5"
                                      Background="White"
                                      Foreground="Black"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}"/>

                        </StackPanel>

                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding StudentsView}"
                              SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="36"
                              ColumnHeaderHeight="40"
                              AlternatingRowBackground="#F8FAFC"
                              BorderBrush="#E2E8F0"
                              BorderThickness="1"
                              Background="White"
                              Foreground="#0F172A">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="55"/>

                            <DataGridTextColumn Header="Ім'я"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Вік"
                                                Binding="{Binding Age}"
                                                Width="65"/>

                            <DataGridTextColumn Header="Маса"
                                                Binding="{Binding Mass, StringFormat=F1}"
                                                Width="75"/>

                            <DataGridTextColumn Header="Оцінки"
                                                Binding="{Binding MarksText}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Сер. бал"
                                                Binding="{Binding AverageMark, StringFormat=F2}"
                                                Width="85"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="15"
                Margin="0,18,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <Button Content="Зберегти JSON"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#059669"/>
                    <Button Content="Завантажити JSON"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#475569"/>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Message}"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           Foreground="#475569"
                           Margin="15,0,0,0"/>

            </Grid>

        </Border>

    </Grid>

</Window>