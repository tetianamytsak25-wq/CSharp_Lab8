<Window x:Class="StudentRegistryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StudentRegistryApp.Controls"
        Title="LED Matrix Display"
        Height="450"
        Width="650"
        MinHeight="350"
        MinWidth="500"
        Background="#F2F5F8"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#DDE5EC"/>
            <Setter Property="Foreground" Value="#243247"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#243247"/>
            <Setter Property="BorderBrush" Value="#D7E0E8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="6">
            <TextBlock Text="LED MATRIX"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#243247"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Світлодіодний матричний дисплей"
                       FontSize="13"
                       Foreground="#7B8998"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,20"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="8"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ПОЛЕ ВІДОБРАЖЕННЯ"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#7B8998"
                               Margin="0,0,0,12"/>

                    <Border Background="#19202B"
                            CornerRadius="7"
                            Padding="8"
                            HorizontalAlignment="Center">
                        <controls:LedMatrixControl x:Name="LedDisplay"/>
                    </Border>

                    <TextBlock Text="Текст для прокручування"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#243247"
                               Margin="0,16,0,6"/>

                    <TextBox Text="{Binding DisplayText, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,12">
                        <Button Content="▶ Запустити"
                                Command="{Binding StartCommand}"
                                Background="#38B878"
                                Foreground="White"
                                Width="130"
                                Margin="0,0,10,0"/>

                        <Button Content="■ Зупинити"
                                Command="{Binding StopCommand}"
                                Width="130"/>
                    </StackPanel>

                    <DockPanel>
                        <TextBlock Text="Швидкість прокручування"
                                   Foreground="#536273"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Speed, StringFormat={}{0} мс}"
                                   Foreground="#279B63"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>

                    <Slider Minimum="20"
                            Maximum="300"
                            Value="{Binding Speed, Mode=TwoWay}"
                            TickFrequency="20"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="РЕДАКТОР СИМВОЛУ 8×10"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#243247"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Натискай на клітинки, щоб змінювати пікселі."
                               FontSize="13"
                               Foreground="#7B8998"
                               Margin="0,0,0,14"/>

                    <controls:GlyphEditorControl x:Name="GlyphEditor"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,14"/>

                    <Button Content="Очистити символ"
                            Command="{Binding ClearGlyphCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18"/>

                    <TextBlock Text="HEX-код (10 байтів)"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#243247"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding HexBytes}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="14"
                               Foreground="#279B63"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Введи 10 байтів у HEX-форматі"
                               FontSize="13"
                               Foreground="#536273"
                               Margin="0,0,0,6"/>

                    <TextBox Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="64"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"/>

                    <Button Content="Завантажити HEX"
                            Command="{Binding ImportHexCommand}"
                            Background="#38B878"
                            Foreground="White"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>